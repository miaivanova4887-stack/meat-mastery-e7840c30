<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules. Same intent as backup_rules.xml:
  refuse to back up WebView state so reinstall = clean state.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="app_webview/" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="app_webview/" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
