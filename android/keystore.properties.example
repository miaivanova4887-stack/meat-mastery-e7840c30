# Copy this file to android/keystore.properties and fill in the values.
# android/keystore.properties is gitignored — DO NOT COMMIT.
#
# storeFile:     absolute or relative path to your upload keystore (.jks)
# storePassword: password to open the keystore
# keyAlias:      alias name used when generating the key
# keyPassword:   password for the key itself (often the same as storePassword)

storeFile=/Users/mia/keystores/carnivorex-upload.jks
storePassword=REPLACE_ME
keyAlias=carnivorex-upload
keyPassword=REPLACE_ME
